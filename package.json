{
  "name": "workflow",
  "version": "2.0.0",
  "private": true,
  "description": "Plan your day, then focus on it. A daily planner that brings tasks, calendar, and focus sessions into one view.",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "lint": "npm run lint -w server",
    "typecheck": "npm run typecheck -w server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nafisa-Huda/WorkFlow.git"
  },
  "license": "ISC"
}
